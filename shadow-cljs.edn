;;; No longer generated by lein-shadow

{:dependencies [[day8.re-frame/tracing "0.6.2"]
                [day8.re-frame/re-frame-10x "1.10.1"]
                [com.hyperphor/way "0.2.2"]
                [com.hyperphor/multitool "0.2.4"]]
 :source-paths ["src/cljs" "src/cljc"]
 :builds
 {:app {:target :browser,
        :compiler-options {:infer-externs true},

        :output-dir "resources/public/cljs-out",
        :asset-path "/cljs-out",
        ;; :js-options {:js-provider :external}
        :modules {:dev-main {:entries [pimento.core]}},
        :devtools {:preloads [day8.re-frame-10x.preload.react-18]},
        :dev {
              :closure-defines {re-frame.trace.trace-enabled? true,
                                day8.re-frame-10x.show-panel false,
                                day8.re-frame.tracing.trace-enabled? true}}}}}
